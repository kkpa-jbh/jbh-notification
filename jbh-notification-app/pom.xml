<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns="http://maven.apache.org/POM/4.0.0"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <artifactId>jbh-notification-parent</artifactId>
    <groupId>com.jbh</groupId>
    <version>1.0.0-SNAPSHOT</version>
  </parent>

  <artifactId>jbh-notification-app</artifactId>
  <name>JBH Notification App</name>
  <description>Runnable Quarkus app of the notification service (port 7778)</description>
  <packaging>jar</packaging>

  <build>
    <plugins>
      <plugin>
        <artifactId>quarkus-maven-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>build</goal>
              <goal>generate-code</goal>
              <goal>generate-code-tests</goal>
            </goals>
          </execution>
        </executions>
        <extensions>true</extensions>
        <groupId>io.quarkus.platform</groupId>
      </plugin>

      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>

      <plugin>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <groupId>org.apache.maven.plugins</groupId>
      </plugin>
    </plugins>
  </build>

  <dependencies>
    <dependency>
      <artifactId>quarkus-arc</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <dependency>
      <artifactId>quarkus-rest</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <dependency>
      <artifactId>quarkus-rest-jackson</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <!-- Health: /q/health -->
    <dependency>
      <artifactId>quarkus-smallrye-health</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <!-- Metrics: Micrometer with the Prometheus registry (/q/metrics) -->
    <dependency>
      <artifactId>quarkus-micrometer-registry-prometheus</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <!-- Logs: JSON console output (enabled in prod only) -->
    <dependency>
      <artifactId>quarkus-logging-json</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <!-- Traces: OpenTelemetry SDK, switched on with OTEL_SDK_DISABLED=false -->
    <dependency>
      <artifactId>quarkus-opentelemetry</artifactId>
      <groupId>io.quarkus</groupId>
    </dependency>

    <!-- Service code. It brings the contracts module. -->
    <dependency>
      <artifactId>jbh-notification-infra</artifactId>
      <groupId>com.jbh</groupId>
    </dependency>

    <dependency>
      <artifactId>quarkus-junit</artifactId>
      <groupId>io.quarkus</groupId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <artifactId>quarkus-junit-mockito</artifactId>
      <groupId>io.quarkus</groupId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <artifactId>mockito-core</artifactId>
      <groupId>org.mockito</groupId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>
    <profile>
      <activation>
        <property>
          <name>native</name>
        </property>
      </activation>
      <id>native</id>
      <properties>
        <quarkus.package.type>native</quarkus.package.type>
        <skipITs>false</skipITs>
      </properties>
    </profile>
  </profiles>
</project>
